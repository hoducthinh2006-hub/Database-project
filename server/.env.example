PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=btl_csdl_khoahoc
DB_SSL=false
# DB online (Railway/Aiven…) có TLS: đặt DB_SSL=true và DB_SSL_CA=<đường dẫn file .pem hoặc nội dung PEM> để XÁC MINH chứng chỉ máy chủ DB
# DB_SSL_CA=

# BẮT BUỘC: chuỗi ngẫu nhiên dài (≥ 24 ký tự) dùng ký token đăng nhập. Server từ chối khởi động nếu thiếu/yếu.
# Tạo nhanh:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Tùy chọn (có giá trị mặc định an toàn, bỏ trống cũng được) ----
# JWT_EXPIRES=24h                 # thời hạn đăng nhập
# NODE_ENV=production             # đặt khi deploy
# TRUST_PROXY=1                   # đặt khi chạy sau proxy (Railway/Render…) để giới hạn tần suất theo đúng IP người dùng
# CORS_ORIGINS=                   # chỉ cần nếu web chạy ở origin KHÁC API; nhiều origin cách nhau bằng dấu phẩy
# LOGIN_MAX_FAILS=5               # đăng nhập sai bao nhiêu lần thì khóa tạm
# LOGIN_LOCK_MIN=15               # khóa tạm bao nhiêu phút
# RATE_LIMIT_API_PER_MIN=300      # số yêu cầu API tối đa / phút / IP
# REGISTER_PER_HOUR=15            # số lần đăng ký tài khoản tối đa / giờ / IP
# LESSON_MIN_SECONDS=20           # học tối thiểu bấy nhiêu giây mới được đánh dấu xong 1 bài (0 = tắt)
# QUIZ_COOLDOWN_SECONDS=15        # chờ bấy nhiêu giây giữa 2 lần làm cùng 1 bài kiểm tra (0 = tắt)
# QUIZ_MIN_SECONDS_PER_QUESTION=2 # nộp nhanh hơn mức này (giây/câu) bị từ chối

# ---- Mã QR "Chuyển khoản" khi thanh toán (tùy chọn) ----
# Để trống thì màn thanh toán chỉ hiện phương thức mô phỏng như cũ, không có QR.
# Điền vào thì trang thanh toán hiện QR VietQR thật — dùng tài khoản THẬT của bạn, cân nhắc trước khi điền
# (đừng commit file .env này; .gitignore đã chặn, nhưng kiểm tra lại trước khi đẩy code lên nơi người khác xem được).
# BANK_BIN:  mã BIN ngân hàng theo chuẩn Napas, ví dụ Vietcombank=970436, MB Bank=970422, Techcombank=970407,
#            BIDV=970418, Agribank=970405, ACB=970416, TPBank=970423, VPBank=970432, Sacombank=970403, MoMo=970454.
#            Tra đủ danh sách: https://api.vietqr.io/v2/banks
# BANK_BIN=
# BANK_ACCOUNT_NO=                # số tài khoản nhận tiền
# BANK_ACCOUNT_NAME=              # tên chủ tài khoản — NÊN viết hoa không dấu, đúng như ngân hàng in (NGUYEN VAN A)
# BANK_NAME=                      # tên ngân hàng hiển thị cho học viên, ví dụ: Vietcombank
# BANK_QR_TEMPLATE=compact2       # mẫu khung QR của VietQR (compact2 là mẫu gọn mặc định, có thể đổi)
